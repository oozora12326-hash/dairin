            >
              内容を修正する
            </button>
            <button
              type="button"
              onclick="navigateTo('property_menu')"
              class="ios-tap bg-[#007AFF] text-white font-bold text-sm py-3 rounded-2xl shadow-xs"
            >
              物件メニューへ戻る
            </button>
          </div>
        </main>
      `;
    }

    // --- 画面6: 参照カタログ＆電工単価管理画面 ---
    function renderCatalogScreen() {
      const cq = state.catalogSearchQuery.trim().toLowerCase();
      const filteredCatalog = state.catalog.filter(item =>
        item.name.toLowerCase().includes(cq) || item.maker.toLowerCase().includes(cq)
      );

      return `
        ${renderSubHeader({ title: '参照カタログ・電工単価', backLabel: '戻る' })}

        <main class="flex-1 px-4 pt-4 pb-24 space-y-5">
          <!-- 1. メーカーWebカタログリンク集（追加・削除可能） -->
          <section class="bg-white rounded-2xl p-4 shadow-xs border border-gray-100">
            <div class="flex items-center justify-between mb-3">
              <div>
                <span class="text-[11px] font-bold text-indigo-600 bg-indigo-50 px-2 py-0.5 rounded-md">外部デジタルカタログ</span>
                <h2 class="text-sm font-bold text-gray-900 mt-1">参考Webカタログ一覧</h2>
              </div>
              <button
                type="button"
                onclick="openAddCatalogLinkModal()"
                class="ios-tap text-xs font-bold text-white bg-[#007AFF] hover:bg-[#0062CC] px-3 py-2 rounded-xl shadow-2xs flex items-center gap-1"
              >
                <span>+ URL追加</span>
              </button>
            </div>
            <p class="text-[11px] text-gray-500 mb-3 leading-relaxed">
              タップすると別タブでメーカー公式カタログが開きます。型番と定価を確認し、下の「器具・定価マスタ」へ登録しておくと見積書で自動計算されます。
            </p>

            ${state.catalogLinks.length === 0 ? `
              <div class="p-6 text-center bg-gray-50 rounded-xl text-xs text-gray-400">
                登録されたWebカタログリンクがありません
              </div>
            ` : `
              <div class="space-y-2">
                ${state.catalogLinks.map(link => `
                  <div class="flex items-center justify-between gap-2 p-3 rounded-xl bg-gray-50 border border-gray-200/80 hover:border-blue-300 transition">
                    <a
                      href="${escapeHtml(link.url)}"
                      target="_blank"
                      rel="noopener noreferrer"
                      class="ios-tap flex-1 flex items-center gap-2.5 min-w-0 text-left"
                    >
                      <div class="w-9 h-9 rounded-lg bg-blue-100 text-[#007AFF] flex items-center justify-center shrink-0">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
                        </svg>
                      </div>
                      <div class="min-w-0 flex-1">
                        <p class="text-sm font-bold text-[#007AFF] truncate flex items-center gap-1">
                          <span class="truncate">${escapeHtml(link.title)}</span>
                          <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
                          </svg>
                        </p>
                        <p class="text-[10px] text-gray-400 truncate mt-0.5">${escapeHtml(link.url)}</p>
                      </div>
                    </a>
                    <button
                      type="button"
                      onclick="confirmDeleteCatalogLink('${link.id}')"
                      class="px-2.5 py-1.5 text-xs font-bold text-red-500 bg-white border border-gray-200 hover:bg-red-50 rounded-lg shrink-0"
                    >
                      削除
                    </button>
                  </div>
                `).join('')}
              </div>
            `}
          </section>

          <!-- 2. 電工単価（1日8h）設定カード -->
          <section class="bg-white rounded-2xl p-4 shadow-xs border border-gray-100">
            <div class="flex items-center justify-between gap-3">
              <div>
                <span class="text-[11px] font-bold text-[#007AFF] bg-blue-50 px-2 py-0.5 rounded-md">施工費算出基準</span>
                <h2 class="text-sm font-bold text-gray-900 mt-1">電工単価（1日8h）</h2>
                <p class="text-[11px] text-gray-500">1時間あたり ¥${formatYen(state.laborDailyRate / 8)} で自動計算</p>
              </div>
              <div class="flex items-center gap-1.5">
                <span class="text-sm font-bold text-gray-500">¥</span>
                <input
                  type="number"
                  inputmode="numeric"
                  value="${escapeHtml(state.laborDailyRate)}"
                  onchange="updateLaborDailyRate(this.value)"
                  class="w-28 text-right font-bold text-base text-gray-900 bg-gray-50 border border-gray-200 rounded-xl px-3 py-2 focus:outline-none focus:bg-white focus:ring-2 focus:ring-[#007AFF]"
                />
              </div>
            </div>
          </section>

          <!-- 3. 見積自動計算用：器具・定価マスタ追加フォーム -->
          <section class="bg-white rounded-2xl p-4 shadow-xs border border-gray-100">
            <div class="mb-3">
              <span class="text-[11px] font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-md">見積書自動計算マスタ</span>
              <h2 class="text-sm font-bold text-gray-900 mt-1">器具・定価を登録（カタログ参照値の記録）</h2>
            </div>
            <div class="space-y-2.5">
              <div>
                <label class="block text-[11px] font-bold text-gray-500 mb-1">器具（内容）・型番名</label>
                <input
                  type="text"
                  id="new-cat-name"
                  placeholder="例: 煙感知器 BV454818"
                  class="w-full rounded-xl bg-gray-50 border border-gray-200 px-3 py-2.5 text-sm text-gray-900 focus:outline-none focus:bg-white focus:ring-2 focus:ring-[#007AFF]/40"
                />
              </div>
              <div class="grid grid-cols-2 gap-2.5">
                <div>
                  <label class="block text-[11px] font-bold text-gray-500 mb-1">メーカー</label>
                  <input
                    type="text"
                    id="new-cat-maker"
                    placeholder="例: パナソニック"
                    class="w-full rounded-xl bg-gray-50 border border-gray-200 px-3 py-2.5 text-sm text-gray-900 focus:outline-none focus:bg-white focus:ring-2 focus:ring-[#007AFF]/40"
                  />
                </div>
                <div>
                  <label class="block text-[11px] font-bold text-gray-500 mb-1">カタログ定価（円）</label>
                  <input
                    type="number"
                    inputmode="numeric"
                    id="new-cat-price"
                    placeholder="例: 9500"
                    class="w-full rounded-xl bg-gray-50 border border-gray-200 px-3 py-2.5 text-sm text-gray-900 focus:outline-none focus:bg-white focus:ring-2 focus:ring-[#007AFF]/40"
                  />
                </div>
              </div>
              <button
                type="button"
                onclick="addCatalogItem()"
                class="ios-tap w-full bg-[#007AFF] hover:bg-[#0062CC] text-white font-bold text-sm py-3 rounded-xl mt-1 shadow-2xs"
              >
                + 器具・定価を登録
              </button>
            </div>
          </section>

          <!-- 4. 登録済み器具・定価一覧 -->
          <section>
            <div class="flex items-center justify-between px-1 mb-2">
              <h2 class="text-xs font-bold text-gray-500">登録済み器具・定価リスト（${filteredCatalog.length}件）</h2>
            </div>

            <!-- 器具検索バー -->
            <div class="mb-2.5">
              <input
                type="search"
                value="${escapeHtml(state.catalogSearchQuery)}"
                oninput="handleCatalogSearchInput(this.value)"
                placeholder="登録済みの器具名・メーカーで絞り込み"
                class="w-full bg-white border border-gray-200 text-gray-900 placeholder-gray-400 text-xs rounded-xl px-3.5 py-2.5 focus:outline-none focus:ring-2 focus:ring-[#007AFF]/40"
              />
            </div>

            <div class="bg-white rounded-2xl shadow-xs border border-gray-100 divide-y divide-gray-100 overflow-hidden">
              ${filteredCatalog.length === 0 ? `
                <div class="p-8 text-center text-xs text-gray-400">一致する器具が登録されていません</div>
              ` : filteredCatalog.map(item => `
                <div class="p-3.5 flex items-center justify-between gap-2">
                  <div class="min-w-0 flex-1">
                    <p class="text-sm font-bold text-gray-900 truncate">${escapeHtml(item.name)}</p>
                    <div class="flex items-center gap-2 mt-0.5 text-xs text-gray-500">
                      <span>メーカー: ${escapeHtml(item.maker)}</span>
                      <span>•</span>
                      <span class="font-bold text-[#007AFF]">定価 ¥${formatYen(item.listPrice)}</span>
                    </div>
                  </div>
                  <button
                    type="button"
                    onclick="confirmDeleteCatalogItem('${item.id}')"
                    class="px-2.5 py-1.5 text-xs font-bold text-red-500 bg-red-50 hover:bg-red-100 rounded-lg shrink-0"
                  >
                    削除
                  </button>
                </div>
              `).join('')}
            </div>
          </section>
        </main>
      `;
    }

    // ==========================================
    // 6. インタラクション・データ操作ハンドラ
    // ==========================================
// ... existing code ... -->
    // 参照カタログ・電工単価・Webリンク操作
    function handleCatalogSearchInput(val) {
      state.catalogSearchQuery = val;
      render();
    }

    // 見積入力行から直接カタログ選択できるピッカーモーダル
    function openCatalogPickerModal(itemIdx) {
      const modalContainer = document.getElementById('modal-container');
      modalContainer.innerHTML = `
        <div class="fixed inset-0 z-50 flex items-end sm:items-center justify-center bg-black/40 backdrop-blur-xs modal-backdrop" onclick="closeModal()">
          <div class="bg-white rounded-t-3xl sm:rounded-3xl w-full max-w-md max-h-[80vh] flex flex-col overflow-hidden shadow-2xl modal-sheet" onclick="event.stopPropagation()">
            <div class="p-4 border-b border-gray-100 flex items-center justify-between">
              <h3 class="text-base font-bold text-gray-900">登録済みカタログから選択</h3>
              <button type="button" onclick="closeModal()" class="text-xs font-bold text-gray-500 px-2.5 py-1 bg-gray-100 rounded-lg">閉じる</button>
            </div>
            <div class="flex-1 overflow-y-auto divide-y divide-gray-100">
              ${state.catalog.length === 0 ? `
                <div class="p-8 text-center text-xs text-gray-400">カタログに器具が登録されていません</div>
              ` : state.catalog.map(cat => `
                <button
                  type="button"
                  onclick="selectCatalogForQuoteRow(${itemIdx}, '${cat.id}')"
                  class="w-full p-3.5 text-left hover:bg-blue-50/60 active:bg-blue-50 flex items-center justify-between gap-2 transition"
                >
                  <div class="min-w-0 flex-1">
                    <p class="text-sm font-bold text-gray-900 truncate">${escapeHtml(cat.name)}</p>
                    <p class="text-xs text-gray-500 mt-0.5">${escapeHtml(cat.maker)}</p>
                  </div>
                  <span class="text-xs font-bold text-[#007AFF] bg-blue-50 px-2.5 py-1 rounded-lg shrink-0">
                    定価 ¥${formatYen(cat.listPrice)}
                  </span>
                </button>
              `).join('')}
            </div>
            <div class="p-3 bg-gray-50 border-t border-gray-100">
              <button
                type="button"
                onclick="closeModal(); navigateTo('catalog');"
                class="w-full py-2.5 text-xs font-bold text-[#007AFF] bg-white border border-blue-200 rounded-xl"
              >
                + 新しい器具・Webカタログを管理する
              </button>
            </div>
          </div>
        </div>
      `;
    }

    function selectCatalogForQuoteRow(itemIdx, catId) {
      const cat = state.catalog.find(c => c.id === catId);
      if (!cat || !state.quoteForm || !state.quoteForm.items[itemIdx]) return;
      state.quoteForm.items[itemIdx].name = cat.name;
      state.quoteForm.items[itemIdx].maker = cat.maker;
      syncQuoteDraft();
      closeModal();
      render();
      showToast(`「${cat.name}」を選択しました`);
    }

    // 参考WebカタログURL追加モーダル
    function openAddCatalogLinkModal() {
      const modalContainer = document.getElementById('modal-container');
      modalContainer.innerHTML = `
        <div class="fixed inset-0 z-50 flex items-end sm:items-center justify-center bg-black/40 backdrop-blur-xs modal-backdrop" onclick="closeModal()">
          <div class="bg-white rounded-t-3xl sm:rounded-3xl w-full max-w-md p-5 pb-8 sm:pb-6 shadow-2xl modal-sheet" onclick="event.stopPropagation()">
            <div class="w-10 h-1 bg-gray-300 rounded-full mx-auto mb-4 sm:hidden"></div>
            <div class="flex items-center justify-between mb-4">
              <h3 class="text-lg font-bold text-gray-900">参考Webカタログを追加</h3>
              <button type="button" onclick="closeModal()" class="text-sm font-medium text-gray-400 hover:text-gray-600">閉じる</button>
            </div>
            <form onsubmit="submitNewCatalogLink(event)" class="space-y-4">
              <div>
                <label class="block text-xs font-bold text-gray-600 mb-1.5">カタログ名・メーカー名 <span class="text-red-500">*</span></label>
                <input
                  type="text"
                  id="input-link-title"
                  required
                  placeholder="例: ヤマトプロテック 総合カタログ"
                  class="w-full rounded-xl bg-gray-50 border border-gray-200 px-3.5 py-3 text-sm text-gray-900 focus:outline-none focus:bg-white focus:ring-2 focus:ring-[#007AFF]"
                />
              </div>
              <div>
                <label class="block text-xs font-bold text-gray-600 mb-1.5">カタログURL <span class="text-red-500">*</span></label>
                <input
                  type="url"
                  id="input-link-url"
                  required
                  placeholder="https://..."
                  class="w-full rounded-xl bg-gray-50 border border-gray-200 px-3.5 py-3 text-sm text-gray-900 focus:outline-none focus:bg-white focus:ring-2 focus:ring-[#007AFF]"
                />
              </div>
              <div class="pt-2 flex gap-2.5">
                <button type="button" onclick="closeModal()" class="flex-1 py-3 rounded-xl bg-gray-100 text-gray-700 font-bold text-sm">キャンセル</button>
                <button type="submit" class="flex-1 py-3 rounded-xl bg-[#007AFF] text-white font-bold text-sm shadow-sm">追加する</button>
              </div>
            </form>
          </div>
        </div>
      `;
      setTimeout(() => document.getElementById('input-link-title')?.focus(), 100);
    }

    function submitNewCatalogLink(e) {
      e.preventDefault();
      const title = document.getElementById('input-link-title').value.trim();
      const url = document.getElementById('input-link-url').value.trim();
      if (!title || !url) return;

      state.catalogLinks.push({
        id: 'link_' + Date.now(),
        title,
        url
      });
      saveCatalogLinks();
      closeModal();
      render();
      showToast(`「${title}」を追加しました`);
    }

    function confirmDeleteCatalogLink(linkId) {
      const target = state.catalogLinks.find(l => l.id === linkId);
      if (!target) return;
      showConfirmModal({
        title: 'Webカタログリンクを削除',
        message: `「${target.title}」を一覧から削除しますか？`,
        confirmText: '削除する',
        onConfirm: () => {
          state.catalogLinks = state.catalogLinks.filter(l => l.id !== linkId);
          saveCatalogLinks();
          render();
          showToast('カタログリンクを削除しました');
        }
      });
    }

    function updateLaborDailyRate(val) {
      const num = Number(val);
      if (num > 0) {
        state.laborDailyRate = num;
        saveLaborRate();
        render();
        showToast(`電工単価を ¥${formatYen(num)} に更新しました`);
      }
    }

    function addCatalogItem() {
      const nameEl = document.getElementById('new-cat-name');
      const makerEl = document.getElementById('new-cat-maker');
      const priceEl = document.getElementById('new-cat-price');

      const name = nameEl.value.trim();
      const maker = makerEl.value.trim() || '指定なし';
      const listPrice = Number(priceEl.value);

      if (!name || !listPrice || listPrice <= 0) {
        showToast('器具名と定価を正しく入力してください', 'error');
        return;
      }

      state.catalog.unshift({
        id: 'cat_' + Date.now(),
        name,
        maker,
        listPrice
      });
      saveCatalog();
      render();
      showToast(`「${name}」を登録しました`);
    }

    function confirmDeleteCatalogItem(catId) {
      const target = state.catalog.find(c => c.id === catId);
      if (!target) return;
      showConfirmModal({
        title: '登録器具を削除',
        message: `「${target.name}」を定価リストから削除しますか？`,
        confirmText: '削除する',
        onConfirm: () => {
          state.catalog = state.catalog.filter(c => c.id !== catId);
          saveCatalog();
          render();
          showToast('カタログから削除しました');
        }
      });
    }

    // ==========================================
    // 7. メインレンダリング関数
    // ==========================================
    function render() {
      const appEl = document.getElementById('app');
      switch (state.currentScreen) {
        case 'home':
          appEl.innerHTML = renderHomeScreen();
          break;
        case 'property_menu':
          appEl.innerHTML = renderPropertyMenuScreen();
          break;
        case 'progress':
          appEl.innerHTML = renderProgressScreen();
          break;
        case 'deficiency':
          appEl.innerHTML = renderDeficiencyScreen();
          break;
        case 'admin_memo':
          appEl.innerHTML = renderAdminMemoScreen();
          break;
        case 'quote_step1':
          appEl.innerHTML = renderQuoteStep1Screen();
          break;
        case 'quote_step2':
          appEl.innerHTML = renderQuoteStep2Screen();
          break;
        case 'quote_preview':
          appEl.innerHTML = renderQuotePreviewScreen();
          break;
        case 'catalog':
          appEl.innerHTML = renderCatalogScreen();
          break;
        default:
          appEl.innerHTML = renderHomeScreen();
      }
    }

    // 初期化実行
    window.addEventListener('DOMContentLoaded', () => {
      loadData();
      render();
    });
  </script>
</body>
</html>
