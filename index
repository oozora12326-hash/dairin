    // --- 画面5-3: 4. 見積書プレビュー画面 ---
    function renderQuotePreviewScreen() {
      const prop = getSelectedProperty();
      if (!prop) return renderHomeScreen();
      const qForm = state.quoteForm;
      const rateRatio = (Number(qForm.rate) || 70) / 100;

      // 各器具の計算
      let materialSubtotal = 0;
      const calculatedRows = qForm.items
        .filter(item => item.name.trim() !== '')
        .map(item => {
          const matched = findCatalogMatch(item.name, item.maker);
          const listPrice = matched ? Number(matched.listPrice) : 0;
          const unitPrice = Math.round(listPrice * rateRatio);
          const qty = Number(item.qty) || 1;
          const amount = unitPrice * qty;
          materialSubtotal += amount;
          return {
            name: item.name,
            maker: item.maker || (matched ? matched.maker : '-'),
            qty,
            listPrice,
            unitPrice,
            amount,
            isMatched: !!matched
          };
        });

      // 施工工事費用の算出: 人数 × 時間 × (電工単価 / 8)
      const workers = Number(qForm.workers) || 1;
      const hours = Number(qForm.hours) || 1;
      const hourlyRate = state.laborDailyRate / 8;
      const laborCost = Math.round(hourlyRate * workers * hours);

      const subtotal = materialSubtotal + laborCost;
      const tax = Math.round(subtotal * 0.1);
      const grandTotal = subtotal + tax;

      const todayStr = new Date().toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' });

      return `
        ${renderSubHeader({
          title: '御見積書プレビュー',
