                      <div class="text-[10px] text-gray-500">
                        作業員 ${workers}名 × ${hours}時間（電工単価 ¥${formatYen(state.laborDailyRate)}/8h）
                      </div>
                    </td>
                    <td class="py-2.5 px-1.5 text-center whitespace-nowrap">1式</td>
                    <td class="py-2.5 px-1.5 text-right whitespace-nowrap">¥${formatYen(laborCost)}</td>
                    <td class="py-2.5 px-2 text-right font-semibold whitespace-nowrap">¥${formatYen(laborCost)}</td>
                  </tr>
                </tbody>
              </table>
            </div>

            <!-- 小計・消費税・合計 -->
            <div class="mt-4 pt-3 border-t border-gray-300 space-y-1.5 text-xs">
              <div class="flex justify-between text-gray-600">
                <span>小計（税抜）</span>
                <span class="font-semibold">¥${formatYen(subtotal)}</span>
              </div>
              <div class="flex justify-between text-gray-600">
                <span>消費税（10%）</span>
                <span class="font-semibold">¥${formatYen(tax)}</span>
              </div>
              <div class="flex justify-between text-sm font-bold text-gray-900 pt-1.5 border-t border-gray-200">
                <span>合計金額（税込）</span>
