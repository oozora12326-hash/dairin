            <div>
              <label class="block text-xs font-bold text-gray-600 mb-1.5">作業時間</label>
              <div class="relative">
                <select
                  onchange="updateQuoteLabor('hours', this.value)"
                  class="w-full appearance-none rounded-xl bg-gray-50 border border-gray-200 px-4 py-3.5 text-base font-bold text-gray-900 focus:outline-none focus:bg-white focus:ring-2 focus:ring-[#007AFF]"
                >
                  ${hourOptions.map(h => `
                    <option value="${h}" ${Number(qForm.hours) === h ? 'selected' : ''}>${h} 時間 ${h === 8 ? '（1日人工）' : h === 4 ? '（半日人工）' : ''}</option>
