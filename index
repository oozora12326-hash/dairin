    // ローカルストレージからデータ読み込み
    function loadData() {
      try {
        const savedProps = localStorage.getItem(STORAGE_KEY_PROPERTIES);
        if (savedProps) {
          state.properties = JSON.parse(savedProps);
        } else {
          state.properties = JSON.parse(JSON.stringify(DEFAULT_PROPERTIES));
          saveProperties();
        }

        const savedCatalog = localStorage.getItem(STORAGE_KEY_CATALOG);
        if (savedCatalog) {
          state.catalog = JSON.parse(savedCatalog);
        } else {
          state.catalog = JSON.parse(JSON.stringify(DEFAULT_CATALOG));
          saveCatalog();
        }

        const savedLinks = localStorage.getItem(STORAGE_KEY_CATALOG_LINKS);
        if (savedLinks) {
          state.catalogLinks = JSON.parse(savedLinks);
        } else {
          state.catalogLinks = JSON.parse(JSON.stringify(DEFAULT_CATALOG_LINKS));
          saveCatalogLinks();
        }

        const savedLabor = localStorage.getItem(STORAGE_KEY_LABOR_RATE);
        if (savedLabor) {
          state.laborDailyRate = Number(savedLabor) || 30000;
        }
      } catch (e) {
        console.error('データ読み込みエラー:', e);
        state.properties = JSON.parse(JSON.stringify(DEFAULT_PROPERTIES));
        state.catalog = JSON.parse(JSON.stringify(DEFAULT_CATALOG));
        state.catalogLinks = JSON.parse(JSON.stringify(DEFAULT_CATALOG_LINKS));
      }
    }

    function saveProperties() {
      try {
        localStorage.setItem(STORAGE_KEY_PROPERTIES, JSON.stringify(state.properties));
      } catch (e) {
        showToast('保存容量の上限に達しました。画像サイズを小さくしてください。', 'error');
      }
    }

    function saveCatalog() {
      try {
        localStorage.setItem(STORAGE_KEY_CATALOG, JSON.stringify(state.catalog));
      } catch (e) {
        console.error('カタログ保存エラー:', e);
      }
    }

