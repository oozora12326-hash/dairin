          </div>

          <!-- 見積書本体カード -->
          <div id="printable-quote-area" class="bg-white rounded-2xl p-5 shadow-xs border border-gray-200">
            <div class="border-b-2 border-gray-900 pb-3 mb-4 flex items-end justify-between">
              <div>
                <h2 class="text-xl font-bold tracking-widest text-gray-900">御 見 積 書</h2>
                <p class="text-xs text-gray-500 mt-1">発行日: ${todayStr}</p>
              </div>
              <div class="text-right text-xs text-gray-600">
                <p>担当: ${escapeHtml(prop.assignee)}</p>
              </div>
            </div>

            <div class="mb-4">
              <p class="text-xs text-gray-500">件名・物件名</p>
              <p class="text-base font-bold text-gray-900 border-b border-gray-300 pb-1">
                ${escapeHtml(prop.name)} 消防設備改修工事
              </p>
            </div>

            <!-- 合計金額ボックス -->
            <div class="bg-gray-50 border border-gray-200 rounded-xl p-3.5 mb-5 flex items-center justify-between">
              <span class="text-xs font-bold text-gray-600">御見積合計金額（税込）</span>
              <span class="text-2xl font-bold text-gray-900">¥${formatYen(grandTotal)}</span>
            </div>

            <!-- 明細テーブル -->
            <div class="overflow-x-auto">
              <table class="w-full text-left border-collapse text-xs">
                <thead>
                  <tr class="border-y border-gray-300 bg-gray-50 text-gray-600">
                    <th class="py-2 px-2 font-bold">器具・工事内容</th>
                    <th class="py-2 px-1.5 text-center font-bold">数量</th>
                    <th class="py-2 px-1.5 text-right font-bold">単価</th>
                    <th class="py-2 px-2 text-right font-bold">金額</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-gray-200">
                  ${calculatedRows.map(row => `
                    <tr>
                      <td class="py-2.5 px-2">
                        <div class="font-bold text-gray-900">${escapeHtml(row.name)}</div>
                        <div class="text-[10px] text-gray-500">
                          メーカー: ${escapeHtml(row.maker)}
                          ${row.isMatched ? ` / 定価 ¥${formatYen(row.listPrice)} × ${qForm.rate}%` : ' (カタログ未登録のため0円)'}
